@model ChurchOfPantoufle.Models.Testimonial

<div class="testimonial-card mb-3">
    <div class="testimonial-content">
        <p>@Model.Content</p>
    </div>
    <div class="testimonial-footer">
        <span class="testimonial-author">— @Model.AuthorName</span>
        @if (Model.WarrenName != null)
        {
            <span class="testimonial-title">@Model.WarrenName</span>
        }
        <small>@Model.DateSubmitted.ToString("MMMM dd, yyyy")</small>
    </div>
    <div class="d-flex gap-2 mt-2">
        @if (!Model.IsApproved)
        {
            <form asp-controller="Admin" asp-action="Approve" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success btn-sm">Approve</button>
            </form>
        }
        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Delete this testimony? This cannot be undone.');">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
    </div>
</div>
