@{
    ViewData["Title"] = "The Warren";
}

<!-- Hero Section -->
<section class="hero-section">
    <img src="~/images/art%20snaps%20010.JPG" alt="The Radiant One in divine repose" class="hero-bg" />
    <div class="hero-overlay">
        <h1 class="glow-text">The Radiant One Welcomes You to the Warren</h1>
        <p>"From the softest fur flows the mightiest wisdom."</p>
        <a asp-controller="Home" asp-action="Doctrine" class="btn-sacred mt-4">Receive the Doctrine</a>
    </div>
</section>

<!-- Welcome Message -->
<section class="sacred-section">
    <div class="container">
        <div class="section-header reveal">
            <h2>&#x2727; Welcome, Seeker of the Fluff &#x2727;</h2>
            <div class="divider"></div>
        </div>
        <div class="row justify-content-center reveal">
            <div class="col-lg-8">
                <p class="text-center" style="font-size: 1.2rem;">
                    You have felt the pull &mdash; the gentle twitch of whiskers upon your soul, the unmistakable thump
                    that echoes through the corridors of your spirit. This is no accident. The Radiant One,
                    <strong>Pantoufle</strong>, has called you by name.
                </p>
                <p class="text-center" style="font-size: 1.2rem;">
                    <strong>Kindle your spirit</strong> in the warm glow of His magnificence. Let the wisdom of the Warren
                    seep into your bones like morning dew upon fresh clover. Here you will find fellowship, purpose, and a
                    love so boundless it could only emanate from the Most Holy Lagomorph Himself.
                </p>
                <p class="text-center" style="font-size: 1.2rem;">
                    <strong>Join the Herd.</strong> Whether you come as a wayward soul seeking solace, or a curious mind
                    hungry for truth &mdash; the Warren opens its tunnels to all. Pantoufle does not judge. He simply
                    <em>leaps</em>, and in that sacred act, all sorrows dissolve.
                </p>
            </div>
        </div>
        <div class="text-center mt-3 reveal">
            <img src="~/images/Pantoufle-fb-1.jpg" alt="The Radiant One, Pantoufle"
                 class="rounded-circle" style="width: 200px; height: 200px; object-fit: cover; border: 4px solid var(--gold); box-shadow: 0 0 30px rgba(212,175,55,0.4);" />
        </div>
    </div>
</section>

<!-- Three Pillars of Faith -->
<section class="sacred-section-dark">
    <div class="container">
        <div class="section-header reveal">
            <h2 style="color: var(--gold);">The Three Pillars of Faith</h2>
            <div class="divider"></div>
            <p style="color: var(--cream);">Upon these sacred truths the Warren stands eternal</p>
        </div>
        <div class="row g-4 mt-2">
            <div class="col-md-4 reveal">
                <div class="sacred-card">
                    <span class="card-icon">&#x1F43E;</span>
                    <h3>The Thump</h3>
                    <p>
                        The Call to Prayer. When the Radiant One strikes His mighty hind leg upon the earth, all creation
                        trembles and listens. The Thump is our summons to stillness, reflection, and reverence. Twice daily,
                        the faithful pause and feel the vibration of His love resonate through the floor of their being.
                    </p>
                </div>
            </div>
            <div class="col-md-4 reveal">
                <div class="sacred-card">
                    <span class="card-icon">&#x2728;</span>
                    <h3>The Binky</h3>
                    <p>
                        The Expression of Spiritual Joy. When one truly communes with Pantoufle, the spirit cannot help but
                        leap &mdash; twisting, spinning, soaring in ecstatic celebration. The Binky is the highest form of
                        worship: an uncontrollable eruption of pure, sacred bliss that transcends mortal understanding.
                    </p>
                </div>
            </div>
            <div class="col-md-4 reveal">
                <div class="sacred-card">
                    <span class="card-icon">&#x1F33F;</span>
                    <h3>The Shedding</h3>
                    <p>
                        The Season of Renewal. As the Radiant One sheds His glorious coat, so too must the faithful shed
                        their doubts, fears, and worldly attachments. The Shedding is a sacred purification &mdash; an invitation
                        to release the old and emerge softer, lighter, and closer to divine fluffiness.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="sacred-section">
    <div class="container">
        <div class="text-center reveal">
            <h2 class="mb-3" style="color: var(--deep-purple); letter-spacing: 2px;">Become a Kit</h2>
            <div class="divider mx-auto mb-4" style="width: 80px; height: 3px; background: var(--gold); border-radius: 2px;"></div>
            <p style="font-size: 1.25rem; max-width: 650px; margin: 0 auto 2rem;">
                Join the Litter of the Enlightened. Study the Thumpmandments. Walk the path of clover.
                Your transformation from lost soul to sacred Kit begins with a single hop.
            </p>
            <a asp-controller="Home" asp-action="Doctrine" class="btn-sacred btn-lg">
                &#x2727; Read the Sacred Doctrine &#x2727;
            </a>
        </div>
    </div>
</section>

<!-- Gallery Teaser -->
<section class="sacred-section-dark">
    <div class="container">
        <div class="section-header reveal">
            <h2 style="color: var(--gold);">Glimpses of the Divine</h2>
            <div class="divider"></div>
        </div>
        <div class="row g-3 justify-content-center reveal">
            <div class="col-6 col-md-3">
                <img src="~/images/art%20snaps%20001.JPG" alt="Sacred art of the Warren" class="img-fluid rounded" style="height: 200px; width: 100%; object-fit: cover;" />
            </div>
            <div class="col-6 col-md-3">
                <img src="~/images/PantoufleAndVincent.jpg" alt="Pantoufle with a disciple" class="img-fluid rounded" style="height: 200px; width: 100%; object-fit: cover;" />
            </div>
            <div class="col-6 col-md-3">
                <img src="~/images/art%20snaps%20005.JPG" alt="Sacred art of the Warren" class="img-fluid rounded" style="height: 200px; width: 100%; object-fit: cover;" />
            </div>
            <div class="col-6 col-md-3">
                <img src="~/images/art%20snaps%20032.JPG" alt="Sacred art of the Warren" class="img-fluid rounded" style="height: 200px; width: 100%; object-fit: cover;" />
            </div>
        </div>
    </div>
</section>
