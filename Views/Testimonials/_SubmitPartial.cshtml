@model ChurchOfPantoufle.Models.Testimonial

<div class="submit-testimonial">
    <h2>Share Your Testimony with the Warren</h2>
    <div class="divider"></div>

    <form asp-controller="Testimonials" asp-action="Submit" method="post" class="sacred-form">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="AuthorName">Your Name</label>
            <input asp-for="AuthorName" class="form-control" placeholder="Enter your name" />
            <span asp-validation-for="AuthorName" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="WarrenName">Your Warren Title <span class="text-muted">(optional)</span></label>
            <input asp-for="WarrenName" class="form-control" placeholder="e.g., Elder Doe, Kit of the Third Burrow" />
            <span asp-validation-for="WarrenName" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Content">Your Testimony</label>
            <textarea asp-for="Content" class="form-control" rows="5" placeholder="Share how Pantoufle has touched your life..."></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-sacred">Offer Your Testimony</button>
    </form>
</div>
